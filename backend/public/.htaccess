<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Authorization header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # /api/... -> LavaLust
    RewriteRule ^api/(.*)$ index.php/api/$1 [END,QSA]

    # Totoong files at folders (React assets, favicon, atbp.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Lahat ng iba -> React (/staff/attendance, /verify-email, atbp.)
    RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|package\.json|package-lock\.json|\.git)">
    Require all denied
</FilesMatch>